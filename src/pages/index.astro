---
import Layout from '../layouts/Layout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { projects } from '../data/projects';
---

<Layout title="Aphotic Labs">
	<canvas id="snow" aria-hidden="true"></canvas>

	<header>
		<a class="mark" href="/">
			<svg viewBox="0 0 32 32" aria-hidden="true">
				<circle cx="16" cy="16" r="13" opacity=".3" />
				<circle cx="16" cy="16" r="7.5" opacity=".65" />
				<circle cx="16" cy="16" r="2.5" class="core" />
			</svg>
			<span>Aphotic Labs</span>
		</a>
	</header>

	<main>
		<section class="hero">
			<h1>Aphotic<br />Labs</h1>
		</section>

		<ul class="grid">
			{projects.map((project, i) => (
				<li class:list={{ featured: i === 0 }}>
					<ProjectTile project={project} featured={i === 0} />
				</li>
			))}
		</ul>
	</main>

	<footer>
		<span>© {new Date().getFullYear()} Aphotic Labs</span>
		<a href="mailto:hello@aphoticlabs.io">hello@aphoticlabs.io</a>
	</footer>
</Layout>

<script>
	// Marine snow: slow-drifting particles that rise as you scroll ("descend").
	const canvas = document.getElementById('snow') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d')!;
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	let w = 0, h = 0, lastScroll = scrollY;
	type Flake = { x: number; y: number; r: number; a: number; vx: number; vy: number; z: number };
	let flakes: Flake[] = [];

	const resize = () => {
		const dpr = Math.min(devicePixelRatio || 1, 2);
		w = innerWidth;
		h = innerHeight;
		canvas.width = w * dpr;
		canvas.height = h * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		const count = Math.round((w * h) / 14000);
		flakes = Array.from({ length: count }, () => {
			const z = Math.random();
			return {
				x: Math.random() * w,
				y: Math.random() * h,
				r: 0.4 + z * 1.4,
				a: 0.08 + z * 0.35,
				vx: (Math.random() - 0.5) * 0.08,
				vy: 0.05 + z * 0.15,
				z,
			};
		});
		if (still) draw(0);
	};

	const draw = (scrollDelta: number) => {
		ctx.clearRect(0, 0, w, h);
		for (const f of flakes) {
			f.x += f.vx;
			f.y += f.vy - scrollDelta * (0.15 + f.z * 0.35);
			if (f.y > h + 4) f.y = -4;
			if (f.y < -4) f.y = h + 4;
			if (f.x > w + 4) f.x = -4;
			if (f.x < -4) f.x = w + 4;
			ctx.beginPath();
			ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(190, 230, 235, ${f.a})`;
			ctx.fill();
		}
	};

	const loop = () => {
		const delta = scrollY - lastScroll;
		lastScroll = scrollY;
		draw(delta);
		requestAnimationFrame(loop);
	};

	addEventListener('resize', resize);
	resize();
	if (!still) loop();
</script>

<style>
	#snow {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
	}

	header,
	main,
	footer {
		position: relative;
		z-index: 1;
		width: min(1200px, 100% - 2.5rem);
		margin-inline: auto;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-dim);
	}
	header::before {
		content: '';
		position: absolute;
		inset: 0 calc(50% - 50vw);
		background: linear-gradient(to bottom, rgba(4, 7, 11, 0.85), transparent);
		backdrop-filter: blur(6px);
		mask: linear-gradient(to bottom, #000 60%, transparent);
		z-index: -1;
	}
	.mark {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--fg);
		text-decoration: none;
	}
	.mark svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: rgb(var(--accent));
		stroke-width: 1.5;
	}
	.mark .core {
		fill: rgb(var(--accent));
		stroke: none;
		animation: pulse 4s ease-in-out infinite;
	}
	@keyframes pulse {
		50% { opacity: 0.35; }
	}

	.hero {
		padding: clamp(4rem, 14vh, 9rem) 0 clamp(3rem, 8vh, 5rem);
	}
	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 11vw, 9rem);
		font-weight: 400;
		line-height: 0.88;
		letter-spacing: -0.045em;
		background: linear-gradient(to bottom, var(--fg) 30%, rgba(215, 227, 234, 0.25));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
	}
	.grid li {
		display: flex;
	}
	.grid li > :global(*) {
		flex: 1;
	}
	.grid .featured {
		grid-column: span 2;
		grid-row: span 2;
	}
	@media (max-width: 900px) {
		.grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 560px) {
		.grid { grid-template-columns: 1fr; }
		.grid .featured { grid-column: auto; grid-row: auto; }
	}

	footer {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 5rem 0 2.5rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg-dim);
	}
	footer a {
		color: inherit;
		text-decoration: none;
		transition: color 0.3s;
	}
	footer a:hover {
		color: rgb(var(--accent));
	}

	@media (prefers-reduced-motion: reduce) {
		.mark .core { animation: none; }
	}
</style>
